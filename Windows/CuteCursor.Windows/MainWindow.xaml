<Window x:Class="CuteCursor.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Cute Cursor" Width="1220" Height="900" MinWidth="1030" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FileDropped" DragOver="FileDragOver">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14"><DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="＋ New pack" Click="NewPack" Margin="0,0,8,0"/><Button Content="Import…" Click="ImportFiles" Margin="0,0,8,0"/><Button Content="Help" Click="Help"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Image Source="Assets/flower.png" Width="43" Height="48" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Cute Cursor" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A little bloom for your everyday clicks." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Row="1" Margin="24,20,24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="PacksTab" Content="Packs" Click="ShowPacks" Margin="0,0,4,0"/><Button x:Name="CursorsTab" Grid.Column="1" Content="Cursors" Click="ShowCursors" Margin="4,0,0,0"/></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Search your library" AutomationProperties.Name="Search library"/><TextBlock Text="Search library…" Margin="12,0" Foreground="{StaticResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <ListBox x:Name="LibraryList" Grid.Row="2" SelectionChanged="LibrarySelectionChanged" AutomationProperties.Name="Cursor library"/>
        <TextBlock Grid.Row="3" Text="Drop images or a .cutecursor pack here.&#x0a;Transparent PNGs work best." FontSize="12" Foreground="{StaticResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap"/>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel>
          <TextBlock x:Name="EmptyState" Text="Start with an image or create a pack.&#x0a;Use Import above to add your first cursor." TextWrapping="Wrap" FontSize="20" Margin="20,80" Visibility="Collapsed"/>
          <StackPanel x:Name="Details">
            <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Rename" Click="Rename" Margin="0,0,6,0"/><Button Content="Export…" Click="Export" Margin="0,0,6,0"/><Button Content="•••" Click="More" AutomationProperties.Name="More actions"/></StackPanel><TextBlock x:Name="SelectionTitle" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/></DockPanel>
            <TextBlock x:Name="SelectionSubtitle" Foreground="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <UniformGrid x:Name="RoleGrid" Columns="4" Margin="-3,0,-3,14"/>
            <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="From library ▾" Click="ChooseLibrary" Margin="0,0,6,0"/><Button Content="Choose photo…" Click="ChoosePhoto"/></StackPanel><TextBlock x:Name="RoleTitle" FontSize="18" FontWeight="SemiBold"/></DockPanel>
            <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Canvas x:Name="ArtCanvas" Width="200" Height="200" Background="Transparent" HorizontalAlignment="Center"><Image x:Name="Art" MouseLeftButtonDown="SetClickPoint" Stretch="Fill"/><Ellipse x:Name="ClickMarker" Width="12" Height="12" Stroke="#33452E" StrokeThickness="2" Fill="#F7D675" IsHitTestVisible="False"/></Canvas><TextBlock Text="Click the image to set its click point" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
                <Border x:Name="TestPad" Grid.Column="1" Background="#F0F2E5" CornerRadius="12" Margin="16,0,0,0" Padding="18" MouseLeftButtonDown="TestClick"><StackPanel VerticalAlignment="Center"><TextBlock Text="Take it for a spin" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="TestHint" Text="Move your cursor here.&#x0a;Give it a click." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
              </Grid>
            </Border>
            <StackPanel x:Name="Adjustments" Margin="0,12,0,0">
              <DockPanel><TextBlock x:Name="SizeLabel" Text="Size · 40" Width="100"/><Slider x:Name="SizeSlider" Minimum="16" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Adjust" AutomationProperties.Name="Cursor size"/></DockPanel>
              <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,14,0"><TextBlock Text="X" Width="20"/><Slider x:Name="XSlider" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="Adjust" AutomationProperties.Name="Click point X"/></DockPanel><DockPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Y" Width="20"/><Slider x:Name="YSlider" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="Adjust" AutomationProperties.Name="Click point Y"/></DockPanel><Button Grid.Column="2" Content="Center" Click="CenterPoint" Padding="12,5"/></Grid>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RestoreButton" Content="Restore" Click="Restore" Margin="0,0,10,0"/><Button x:Name="ApplyButton" Content="Apply pack ↗" Style="{StaticResource Primary}" Click="Apply" MinWidth="145"/></StackPanel>
      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="Status" Text="Ready when you are." TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="System-wide on Windows · some apps use their own cursors" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    </DockPanel></Border>
  </Grid>
</Window>
